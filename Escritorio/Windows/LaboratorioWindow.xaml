<Window x:Class="Escritorio.Windows.LaboratorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Shared.Models;assembly=Shared"
        xmlns:vm="clr-namespace:Escritorio.Mvvm"
        Title="Laboratorios" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:LaboratorioViewModel/>
    </Window.DataContext>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,10">
            <Button x:Name="btnImagenregresar" Click="btnImagenregresar_Click" 
                    Height="28" Width="28" Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="pack://application:,,,/Images/Atras.png" Stretch="Uniform" Opacity="0.7"/>
            </Button>

            <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="20,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusMensaje}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#4B5563"/>
        </StackPanel>

        <!-- Lista de Laboratorios -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
            <ItemsControl ItemsSource="{Binding ListaLaboratorios}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Laboratorios}">
                        <!-- Tarjeta Principal del Laboratorio -->
                        <Border Background="White" CornerRadius="12" Margin="15" Width="220" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.08" Color="#000000" Direction="270"/>
                            </Border.Effect>

                            <!-- Usamos StackPanel para que los elementos se apilen naturalmente -->
                            <StackPanel>

                                <!-- Título y Dirección -->
                                <TextBlock Text="{Binding NombreLaboratorio}" HorizontalAlignment="Center" 
                                           FontWeight="Bold" FontSize="16" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DireccionLora}" HorizontalAlignment="Center" 
                                           FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,15"/>

                                <!-- Icono de la Puerta -->
                                <Image HorizontalAlignment="Center" Height="55" Width="55" Margin="0,0,0,15">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="pack://application:,,,/Images/Puerta_cerrada.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DatosPuerta.EstadoPuerta}" Value="Abierto">
                                                    <Setter Property="Source" Value="pack://application:,,,/Images/Puerta_abierta.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Contenedor de Horarios -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Inicio -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="INICIO" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatosPuerta.HoraInicio}" FontWeight="Bold" FontSize="13" Foreground="#374151" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Final -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="FINAL" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatosPuerta.HoraFinal}" FontWeight="Bold" FontSize="13" Foreground="#374151" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Información del Usuario (en una cajita sutil) -->
                                <Border Background="#F3F4F6" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DatosPuerta.UsuarioNombre}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="#1F2937" 
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DatosPuerta.UsuarioNombre}"/>
                                        <TextBlock Text="{Binding DatosPuerta.Cargo}" 
                                                   FontSize="11" FontStyle="Italic" Foreground="#4B5563" 
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botón de Acción -->
                                <Button Content="Abrir Lab" HorizontalAlignment="Stretch" Height="35" Cursor="Hand"
                                        Command="{Binding DataContext.AbrirLabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Background="#0097E6" Foreground="White" FontWeight="Bold" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barra Inferior -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnHistorialpeticiones" Content="Ver Historial de Peticiones" 
                        Background="#10B981" Foreground="White" FontWeight="SemiBold" 
                        Padding="20,10" Cursor="Hand" BorderThickness="0" 
                        Click="btnHistorialpeticiones_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>