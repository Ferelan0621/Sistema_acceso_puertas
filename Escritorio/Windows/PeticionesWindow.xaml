<Window x:Class="Escritorio.Windows.PeticionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Petición de Acceso" Height="360" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" Topmost="True" ResizeMode="NoResize">
	<Border Padding="25" Background="#F5F6FA">
		<StackPanel>
			<TextBlock Text="¡NUEVA PETICIÓN!" FontWeight="Bold" FontSize="20" Foreground="#0097E6" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<Border Background="White" BorderBrush="#DCDDE1" BorderThickness="1" Padding="15" Margin="0,0,0,25">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="Usuario:" FontWeight="Bold" Foreground="#2F3640" Margin="0,5,15,5" FontSize="14"/>
					<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NombreUsuario}" Foreground="#2F3640" Margin="0,5,0,5" FontSize="14"/>

					<TextBlock Grid.Row="1" Grid.Column="0" Text="Rol:" FontWeight="Bold" Foreground="#2F3640" Margin="0,5,15,5" FontSize="14"/>
					<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RolUsuario}" Foreground="#2F3640" Margin="0,5,0,5" FontSize="14"/>

					<TextBlock Grid.Row="2" Grid.Column="0" Text="Laboratorio:" FontWeight="Bold" Foreground="#2F3640" Margin="0,5,15,5" FontSize="14"/>
					<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NombreLaboratorio}" Foreground="#2F3640" Margin="0,5,0,5" FontSize="14"/>

					<TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha:" FontWeight="Bold" Foreground="#2F3640" Margin="0,5,15,5" FontSize="14"/>
					<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Peticion.FechaPrestamo}" Foreground="#2F3640" Margin="0,5,0,5" FontSize="14"/>
				</Grid>
			</Border>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Button Content="Aceptar" Background="#44BD32" Foreground="White" FontWeight="Bold"
                        Margin="0,0,8,0" Padding="12,8" Cursor="Hand" BorderThickness="0"
                        Command="{Binding ViewModel.AceptarPeticionCommand}"
                        CommandParameter="{Binding Peticion}" Click="CerrarVentana_Click"/>
				<Button Content="Cerrar Lab" Background="#E67E22" Foreground="White" FontWeight="Bold"
                        Margin="0,0,8,0" Padding="12,8" Cursor="Hand" BorderThickness="0"
                        Command="{Binding ViewModel.CerrarLabCommand}"
                        CommandParameter="{Binding Peticion}" Click="CerrarVentana_Click"/>
				<Button Content="Denegar" Background="#E84118" Foreground="White" FontWeight="Bold"
                        Padding="12,8" Cursor="Hand" BorderThickness="0"
                        Command="{Binding ViewModel.DenegarPeticionCommand}"
                        CommandParameter="{Binding Peticion}" Click="CerrarVentana_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
	
</Window>