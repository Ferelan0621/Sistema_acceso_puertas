<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Movil.Pages.Logout"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Logout">

    <Grid Padding="18" RowDefinitions="Auto, *" RowSpacing="20">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="15">

            <Border WidthRequest="54" HeightRequest="54" BackgroundColor="White" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Radius="10" Offset="0,4" Opacity="0.08" Brush="Black"/>
                </Border.Shadow>
                <Label Text="UPT" FontSize="16" FontAttributes="Bold" TextColor="#7A0017" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="CERRAR SESIÓN" FontSize="11" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="#8A8A8A"/>
                </HorizontalStackLayout>
                <Label Text="Logout" FontSize="22" FontAttributes="Bold" TextColor="#1C1C1E"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="12" VerticalOptions="Center">

            <VerticalStackLayout VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="20">

                <Label Text="¿Deseas salir de la aplicación?" 
                       FontSize="16" 
                       TextColor="#8E8E93" 
                       HorizontalTextAlignment="Center" 
                       FontAttributes="Bold"/>

                <Button x:Name="Cerrar_Sesión" 
                        Text="Cerrar Sesión" 
                        Clicked="Cerrar_Sesión_Clicked" 
                        BackgroundColor="#111111" 
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="8"
                        HeightRequest="48"
                        WidthRequest="220"
                        HorizontalOptions="Center" 
                        VerticalOptions="Center"/>

            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>